{
  "manifest_version": 3,
  "name": "前端性能诊断台",
  "version": "0.4.0",
  "description": "持久化页面评测历史，采集真实运行环境与内存趋势，并生成综合 Web 质量诊断。",
  "permissions": ["activeTab", "storage", "scripting"],
  "optional_permissions": ["processes"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "分析当前页面",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["probes/runtime.js", "probes/snapshot.js", "probes/audits.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
